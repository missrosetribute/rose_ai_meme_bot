"""
Dynamic Image Generator - Vintage Pinup Rose Style
Uploads to OpenAI Files API once for fast reuse via file_id
"""

import anthropic
import openai
import base64
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
import textwrap
import os

ROSE_BASE_IMAGE = "rose_avatar_alt4.jpg"

ROSE_REFERENCE_FILES = [
    "rose_avatar.png",
    "rose_avatar_alt.png",
    "rose_avatar_alt2.png",
    "rose_avatar_alt3.jpg",
    "rose_avatar_alt4.jpg",
]


def detect_media_type(data: bytes) -> str:
    """Detect image media type from magic bytes."""
    if data[:3] == b'\xff\xd8\xff':
        return "image/jpeg"
    if data[:8] == b'\x89PNG\r\n\x1a\n':
        return "image/png"
    if data[:6] in (b'GIF87a', b'GIF89a'):
        return "image/gif"
    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
        return "image/webp"
    return "image/jpeg"


class VintageRoseImageGenerator:
    """Generate vintage pinup Rose meme images."""

    def __init__(self):
        """Initialize clients and upload base image once."""
        self.claude_client = anthropic.Anthropic()
        self.openai_client = openai.OpenAI(api_key=os.getenv('OPENAI_API_KEY'))
        self.target_width = 852
        self.target_height = 1280
        self.rose_references_b64 = self._load_references_for_claude()
        self.rose_base_file_id = self._upload_base_image()

    def _load_references_for_claude(self) -> list[dict]:
        """Load all reference images as base64 for Claude."""
        references = []
        for filename in ROSE_REFERENCE_FILES:
            try:
                with open(filename, "rb") as f:
                    raw = f.read()
                media_type = detect_media_type(raw)
                b64_data = base64.standard_b64encode(raw).decode("utf-8")
                references.append({
                    "filename": filename,
                    "media_type": media_type,
                    "b64_data": b64_data,
                })
                print(f"✅ Loaded vintage reference: {filename}")
            except Exception as e:
                print(f"⚠️ Could not load {filename}: {e}")
        return references

    def _upload_base_image(self) -> str | None:
        """Upload base image to OpenAI Files API once."""
        try:
            with open(ROSE_BASE_IMAGE, "rb") as f:
                raw = f.read()
            img = Image.open(BytesIO(raw)).convert("RGBA")
            png_bytes = BytesIO()
            img.save(png_bytes, format="PNG")
            png_bytes.seek(0)
            png_bytes.name = "rose_vintage_base.png"
            response = self.openai_client.files.create(file=png_bytes, purpose="vision")
            file_id = response.id
            print(f"✅ Uploaded vintage Rose base — file_id: {file_id}")
            return file_id
        except Exception as e:
            print(f"⚠️ File upload failed: {e}")
            return None

    def generate_rose_image(self, meme_prompt: str, meme_caption: str) -> Image.Image:
        """Generate a vintage pinup Rose meme."""
        try:
            visual_description = self._generate_rose_description(meme_prompt, meme_caption)
            print(f"✅ Description: {visual_description}")
            rose_image = self._generate_image_edit(visual_description, meme_caption)
            print("✅ Vintage Rose image generated")
            return rose_image
        except Exception as e:
            print(f"❌ Error: {e}")
            return self._create_fallback_image(meme_caption)

    def _generate_rose_description(self, meme_prompt: str, meme_caption: str) -> str:
        """Claude studies vintage Rose and describes the scene."""
        if not self.rose_references_b64:
            return "Rose stands confidently with orange/red wavy hair and a green bow in vintage pinup style."

        content: list[dict] = [
            {"type": "text", "text": "Study these vintage pinup Rose reference images:"}
        ]

        for ref in self.rose_references_b64:
            content.append({
                "type": "image",
                "source": {
                    "type": "base64",
                    "media_type": ref["media_type"],
                    "data": ref["b64_data"],
                },
            })

        content.append({
            "type": "text",
            "text": f"""Create a vintage pinup scene description for Rose.

Context: "{meme_prompt}"
Caption: "{meme_caption}"

PRESERVE: Vintage 1950s pinup style, orange/red hair, green bow, confident expression, pinup fashion
CHANGE: outfit, pose, props, setting to match context
Describe text placement and vintage font style (bubble letters, script, comic, poster)

Return ONLY 2-3 sentence description."""
        })

        try:
            message = self.claude_client.messages.create(
                model="claude-sonnet-4-5",
                max_tokens=300,
                messages=[{"role": "user", "content": content}],
            )
            return message.content[0].text.strip()
        except Exception as e:
            print(f"⚠️ Claude error: {e}")
            return "Vintage Rose in retro 1950s pinup style, confident and fabulous."

    def _generate_image_edit(self, rose_description: str, caption: str) -> Image.Image:
        """gpt-image-1 edit using file_id or base64 fallback."""
        prompt = (
            "VINTAGE PINUP ROSE: Preserve pinup face, orange/red hair, green bow, retro 1950s aesthetic. "
            f"Change: outfit, pose, props, setting to match: {rose_description} "
            f"Add caption: '{caption}' in appropriate vintage font. Keep retro 1950s pinup style."
        )
        if len(prompt) > 1500:
            prompt = prompt[:1500]

        if self.rose_base_file_id:
            try:
                print("🎨 Vintage gpt-image-1 edit via file_id")
                response = self.openai_client.images.edit(
                    model="gpt-image-1",
                    image=[{"type": "image_file", "file_id": self.rose_base_file_id}],
                    prompt=prompt,
                    size="1024x1536",
                    n=1,
                )
                image_data = base64.b64decode(response.data[0].b64_json)
                return Image.open(BytesIO(image_data))
            except Exception as e:
                print(f"⚠️ file_id failed: {e}, trying base64...")

        return self._generate_image_edit_base64(prompt)

    def _generate_image_edit_base64(self, prompt: str) -> Image.Image:
        """Fallback: send base64 inline."""
        try:
            with open(ROSE_BASE_IMAGE, "rb") as f:
                raw = f.read()
            img = Image.open(BytesIO(raw)).convert("RGBA")
            png_bytes = BytesIO()
            img.save(png_bytes, format="PNG")
            png_bytes.seek(0)
            png_bytes.name = "rose.png"
            print("🎨 Vintage gpt-image-1 edit via base64 (fallback)")
            response = self.openai_client.images.edit(
                model="gpt-image-1",
                image=png_bytes,
                prompt=prompt,
                size="1024x1536",
                n=1,
            )
            image_data = base64.b64decode(response.data[0].b64_json)
            return Image.open(BytesIO(image_data))
        except Exception as e:
            print(f"❌ Base64 failed: {e}")
            return self._create_fallback_image("")

    def compose_meme(self, rose_image: Image.Image, caption: str):
        """Resize to target dimensions."""
        try:
            rose_image = rose_image.resize(
                (self.target_width, self.target_height),
                Image.Resampling.LANCZOS,
            )
            meme = rose_image.convert("RGB")
            img_bytes = BytesIO()
            meme.save(img_bytes, format="JPEG", quality=90)
            img_bytes.seek(0)
            return img_bytes
        except Exception as e:
            print(f"❌ Compose error: {e}")
            return self._create_fallback_image(caption)

    def _create_fallback_image(self, caption: str):
        """Fallback image."""
        img = Image.new("RGB", (self.target_width, self.target_height), (26, 26, 46))
        draw = ImageDraw.Draw(img)
        try:
            font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 32)
        except Exception:
            font = ImageFont.load_default()
        draw.text((50, 600), "Vintage Rose Meme", font=font, fill=(255, 200, 220))
        if caption:
            draw.text((50, 700), caption, font=font, fill=(255, 255, 255))
        img_bytes = BytesIO()
        img.save(img_bytes, format="JPEG", quality=90)
        img_bytes.seek(0)
        return img_bytes
